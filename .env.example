# Local silo_ai_svc endpoint.
SILO_BASE_URL=http://127.0.0.1:4040
SILO_API_KEY=
SILO_MODEL=proxima/gpt-5.4
SILO_FALLBACK_MODELS=openai-codex/gpt-5.5

# Stable system/developer-style guidance sent to Silo on every turn.
SILO_INSTRUCTIONS=You are chatting over WhatsApp. Keep replies clear, useful, and concise. Avoid markdown tables.

# WhatsApp Web auth state. This stores linked-device credentials; keep it private.
WHATSAPP_AUTH_DIR=.data/whatsapp/default

# Comma-separated E.164 phone numbers allowed to chat with this bridge.
# Use "*" only on a private number where you intentionally want any DM to be handled.
WHATSAPP_ALLOW_FROM=

# Set true if you want messages sent by the linked account itself to be processed.
WHATSAPP_SELF_CHAT_MODE=false

# Group chats are ignored unless enabled. If enabled, only groups listed here are handled unless "*" is present.
WHATSAPP_ENABLE_GROUPS=false
WHATSAPP_ALLOW_GROUPS=

# WhatsApp text messages are capped; the bridge splits longer Silo replies.
WHATSAPP_TEXT_CHUNK_LIMIT=3500

# Inbound WhatsApp media is saved here and can be attached to Gmail sends/drafts.
WHATSAPP_ATTACHMENT_DIR=.data/attachments
WHATSAPP_ATTACHMENT_MAX_MB=25

# Optional Gmail bridge through local gog CLI.
GOG_ENABLED=true
GOG_PATH=/home/openclaw/.local/bin/gog
GOG_ACCOUNT=
GOG_ALLOW_SEND=false
GOG_DEFAULT_EMAIL_SEARCH=is:unread newer_than:7d
